# Copy to .env and fill in. Never commit .env.
# All values shown are the defaults the code falls back to if unset.

# Path to the trained xgboost baseline checkpoint. Generated by `make baseline`.
BASELINE_XGB_PATH=./ml/checkpoints/baseline_xgb.json
BASELINE_RF_PATH=./ml/checkpoints/baseline_rf.joblib
BASELINE_LOGREG_PATH=./ml/checkpoints/baseline_logreg.joblib

# Path to the trained CNN checkpoint. Generated by `make cnn`.
CNN_PATH=./ml/checkpoints/cnn_best.pt

# Gradio app port. Default 7860 matches Gradio's own default.
GRADIO_PORT=7860

# Hugging Face Hub username for the eventual model card / Space.
# Leave blank in Phase 1; CI/CD plumbing reads it when the maintainer deploys.
HF_USERNAME=

# Optional — Anthropic key for the deferred Phase 2 LLM explainer panel.
# Nothing reads this in Phase 1.
ANTHROPIC_API_KEY=
